NODE_ENV=development
DEV_SEED_ENABLED=false
DEV_SEED_ADMIN_PASSWORD=replace-with-a-local-only-password-of-at-least-12-characters
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001
AUTH_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
