# ==============================================================================
# SisPiro ERP — Configuração de Ambiente para Produção (.env.production)
# ==============================================================================
# Copie este arquivo para .env.production e preencha com senhas e chaves seguras.
# NUNCA commite senhas de produção no repositório Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados PostgreSQL 16
# ------------------------------------------------------------------------------
POSTGRES_DB=erp_pirotecnico
POSTGRES_USER=sispiro_app
POSTGRES_PASSWORD=defina_uma_senha_forte_aqui_com_mais_de_24_caracteres_123!
POSTGRES_HOST_PORT=5432

# ------------------------------------------------------------------------------
# 2. Redis 7 (Cache, Filas BullMQ e Rate Limiter Atômico)
# ------------------------------------------------------------------------------
REDIS_HOST_PORT=6379

# ------------------------------------------------------------------------------
# 3. Autenticação & Criptografia (Gere segredos aleatórios com: openssl rand -hex 32)
# ------------------------------------------------------------------------------
AUTH_JWT_SECRET=gere_uma_chave_hexadecimal_aleatoria_com_openssl_rand_hex_32
AUTH_JWT_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=gere_outra_chave_hexadecimal_aleatoria_para_o_refresh_token
AUTH_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. URLs, Domínios e CORS
# ------------------------------------------------------------------------------
# URL pública onde o Frontend do SisPiro será acessado pelos usuários:
APP_URL=https://erp.casadefogos.com.br

# Origens autorizadas para requisições no backend (separadas por vírgula):
CORS_ORIGIN=https://erp.casadefogos.com.br

# URLs públicas da API para o cliente Next.js:
NEXT_PUBLIC_API_URL=https://erp.casadefogos.com.br/api/v1
NEXT_PUBLIC_API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 5. Módulo Fiscal & SEFAZ (Focus NFe)
# ------------------------------------------------------------------------------
# Ambiente: 'sandbox' (homologação) ou 'production' (SEFAZ oficial)
FOCUS_NFE_ENV=sandbox
FOCUS_NFE_TOKEN=seu_token_api_focus_nfe_aqui

# ------------------------------------------------------------------------------
# 6. Rotinas de Inicialização de Containers
# ------------------------------------------------------------------------------
# Executar migrações do Prisma automaticamente no boot do container? (true/false)
RUN_MIGRATIONS=true

# Executar seed de dados iniciais no primeiro boot? (true/false)
# ATENÇÃO: Defina true APENAS na primeira implantação para criar o usuário admin inicial.
RUN_SEED=false
